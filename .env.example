################################################################################
# PNLCS — Panelica License & Customer System
# .env.example — copy to .env and adjust values for your environment
################################################################################

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=PNLCS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database (MySQL 8 required) ─────────────────────────────────────────────
# Create the database and user BEFORE running `php artisan migrate`.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pnlcs
DB_USERNAME=pnlcs
DB_PASSWORD=

# Optional: use Unix socket instead of TCP (leave commented for TCP)
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# ── Session / Cache / Queue ─────────────────────────────────────────────────
# "file" drivers work out of the box. Switch to redis/database once tables exist.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ── Redis (optional — for cache/queue/session when CACHE_STORE=redis) ───────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ────────────────────────────────────────────────────────────────────
# Default "log" driver writes emails to storage/logs/laravel.log for testing.
# Switch to "smtp" with real credentials for production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Memcached (optional) ────────────────────────────────────────────────────
MEMCACHED_HOST=127.0.0.1

# ── AWS S3 (optional — for file storage) ────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Vite (frontend build) ───────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
